{
    "name": "engagement/platform",
    "description": "Generic CakePHP 5 admin kit and engagement survey platform",
    "license": "MIT",
    "type": "project",
    "homepage": "https://cakephp.org",
    "require": {
        "php": ">=8.2",
        "cakephp/authentication": "^3.3",
        "cakephp/authorization": "^3.4",
        "cakephp/cakephp": "5.4.*",
        "cakephp/migrations": "^5.0",
        "cakephp/plugin-installer": "^2.0",
        "dompdf/dompdf": "^3.1",
        "mobiledetect/mobiledetectlib": "^4.8.03",
        "phpoffice/phppresentation": "^1.1",
        "phpoffice/phpword": "^1.3"
    },
    "require-dev": {
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility.",
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "phpstan/phpstan": "PHPStan focuses on finding errors in your code without actually running it. It catches whole classes of bugs even before you write tests for the code."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "AdminKit\\": "plugins/AdminKit/src/",
            "Organisation\\": "plugins/Organisation/src/",
            "Survey\\": "plugins/Survey/src/",
            "Analytics\\": "plugins/Analytics/src/",
            "Reporting\\": "plugins/Reporting/src/",
            "Feedback360\\": "plugins/Feedback360/src/",
            "ActionPlanning\\": "plugins/ActionPlanning/src/",
            "Pulse\\": "plugins/Pulse/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "App\\Console\\Installer::postInstall",
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "test": "phpunit --colors=always"
    }
}
